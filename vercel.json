{
  "buildCommand": "npx nx build dashboard",
  "outputDirectory": "dist/dashboard/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/env.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "installCommand": "npm ci --legacy-peer-deps"
}
