{
  "buildCommand": "NPM_CONFIG_PRODUCTION=false npm ci --legacy-peer-deps && npx nx build dashboard",
  "outputDirectory": "dist/dashboard/browser",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/env.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
